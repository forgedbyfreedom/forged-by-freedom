import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';

/* ===========================
   HARD CONFIG
=========================== */
const TOP_K = 12;
const MIN_LONG_QUOTE_CHARS = 300;
const MAX_EXECUTION_MS = 20000;

/* ===========================
   ENTRY POINT
=========================== */
export async function askCoach(payload) {
  const question = payload?.question?.trim();
  if (!question) {
    throw new Error("NO_QUESTION_PROVIDED");
  }

  const embedding = await embedQuestion(question);
  const pineconeMatches = await queryPinecone(embedding);

  const evidence = extractEvidence(pineconeMatches);

  if (!evidence.length) {
    throw new Error("INSUFFICIENT_DB_EVIDENCE");
  }

  const prompt = buildStrictPrompt(question, evidence);
  const answer = await runOpenRouter(prompt);

  return {
    success: true,
    evidenceCount: evidence.length,
    answer
  };
}

/* ===========================
   OPENROUTER EMBEDDING
=========================== */
async function embedQuestion(text) {
  const key = await getSecret("OPENROUTER_API_KEY");
  const base = process.env.OPENROUTER_BASE_URL;

  const res = await fetch(`${base}/embeddings`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${key}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      model: process.env.OPENROUTER_EMBED_MODEL,
      input: text
    })
  });

  const json = await res.json();
  return json.data[0].embedding;
}

/* ===========================
   PINECONE QUERY (FIXED)
=========================== */
async function queryPinecone(vector) {
  const apiKey = await getSecret("PINECONE_API_KEY");
  const host = process.env.PINECONE_HOST;

  const res = await fetch(`https://${host}/query`, {
    method: "POST",
    headers: {
      "Api-Key": apiKey,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      vector,
      topK: TOP_K,
      includeMetadata: true
    })
  });

  const json = await res.json();
  return json.matches || [];
}

/* ===========================
   EVIDENCE EXTRACTION
=========================== */
function extractEvidence(matches) {
  const valid = matches
    .map(m => m.metadata)
    .filter(m => m?.text && m.text.length > 50);

  const longQuotes = valid.filter(v => v.text.length >= MIN_LONG_QUOTE_CHARS);

  if (valid.length >= 3) {
    return valid.slice(0, 3);
  }

  if (longQuotes.length >= 1) {
    return [longQuotes[0]];
  }

  return [];
}

/* ===========================
   STRICT PROMPT BUILDER
=========================== */
function buildStrictPrompt(question, quotes) {
  const formattedQuotes = quotes.map((q, i) => `
QUOTE ${i + 1}:
"${q.text}"

— ${q.speaker}, ${q.podcast} (${q.episode})
`).join("\n");

  return `
SYSTEM — NON-NEGOTIABLE RULES:

• You are Coach Bryan’s AI research engine
• You MUST paraphrase the question
• You MUST answer ONLY using provided database quotes
• You MUST explain the medical / physiological "why"
• You MUST close with a motivational quote from Coach Bryan
• DO NOT introduce outside knowledge

USER QUESTION:
${question}

DATABASE EVIDENCE:
${formattedQuotes}
`;
}

/* ===========================
   OPENROUTER COMPLETION
=========================== */
async function runOpenRouter(prompt) {
  const key = await getSecret("OPENROUTER_API_KEY");
  const base = process.env.OPENROUTER_BASE_URL;

  const controller = new AbortController();
  setTimeout(() => controller.abort(), MAX_EXECUTION_MS);

  const res = await fetch(`${base}/chat/completions`, {
    method: "POST",
    signal: controller.signal,
    headers: {
      "Authorization": `Bearer ${key}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      model: process.env.OPENROUTER_MODEL,
      messages: [{ role: "user", content: prompt }],
      temperature: 0.15
    })
  });

  const json = await res.json();
  return json.choices[0].message.content;
}


// backend/aiQuery.jsw
// Wix backend for Coach Bryan AI queries
// Uses OpenRouter for embeddings + chat, Pinecone for vector search

import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';

/* ============================================================
   CONFIG
============================================================ */
const CONFIG = {
  openRouterBase: "https://openrouter.ai/api/v1",
  chatModel: "nousresearch/hermes-3-llama-3.1-70b",
  embedModel: "text-embedding-3-large",
  pineconeHost: "forged-freedom-ai-yniiyt3.svc.aped-4627-b74a.pinecone.io",
  topK: 12,
  maxQuotes: 10,
  timeout: 25000
};

/* ============================================================
   PUBLIC: ANALYZE BLOODWORK (routes to Render /analyze-bloodwork)
============================================================ */
export async function analyzeBloodwork(labText) {
  try {
    if (!labText?.trim()) {
      return { status: "ERROR", message: "Please paste your lab results." };
    }

    const resp = await fetch("https://forged-by-freedom-api-nm4f.onrender.com/analyze-bloodwork", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ labs: labText.trim() })
    });

    const data = await resp.json();

    if (data?.answer) {
      return { status: "OK", answer: data.answer, sources: data.sources || [] };
    } else {
      return { status: "ERROR", message: data?.error || "Analysis failed" };
    }
  } catch (err) {
    console.error("[analyzeBloodwork ERROR]", err.message);
    return { status: "ERROR", message: "Bloodwork analysis failed: " + err.message };
  }
}

/* ============================================================
   PUBLIC: ASK COACH BRYAN
============================================================ */
export async function askCoach(payload) {
  try {
    // Validate input
    if (!payload?.question?.trim()) {
      return { status: "ERROR", code: "INVALID_INPUT", message: "Question required" };
    }

    const question = payload.question.trim();

    // User profile (optional — frontend can pass gender + experience level)
    const userProfile = {
      gender: payload.gender || null,           // "male", "female", or null
      experienceLevel: payload.experienceLevel || null,  // "beginner", "intermediate", "advanced", or null
    };

    // Conversation history (optional — last 5 turns for context)
    const history = Array.isArray(payload.history) ? payload.history.slice(-5) : [];

    // Detect bloodwork requests
    const isBloodwork = question.toLowerCase().includes("bloodwork") || question.toLowerCase().includes("lab results");

    // ── FAST PATH: Bloodwork (skip Pinecone entirely — prompt has all the rules) ──
    if (isBloodwork) {
      const trimmedQuestion = question.length > 3000 ? question.substring(0, 3000) + "\n[...truncated]" : question;
      const answer = await synthesizeBloodwork(trimmedQuestion);
      return { status: "OK", answer, sources: [{ speaker: "Coach Bryan", channel: "Forged by Freedom", title: "Bloodwork Analysis" }] };
    }

    // ── NORMAL PATH: Embed → Pinecone → Synthesize ──
    const vector = await embed(question);

    const matches = await searchPinecone(vector, false);
    if (!matches.length) {
      return { status: "ERROR", code: "NO_MATCHES", message: "No relevant content found" };
    }

    const isFemale = userProfile.gender === "female" || isFemaleRelatedQuestion(question);
    const quotes = extractQuotes(matches, question, isFemale);
    if (!quotes.length) {
      return { status: "ERROR", code: "NO_EVIDENCE", message: "No usable text found" };
    }

    const answer = await synthesize(question, quotes, history, userProfile);

    return {
      status: "OK",
      answer,
      sources: quotes.map(q => ({
        speaker: q.speaker,
        channel: q.displayName || q.channel,
        title: q.title
      }))
    };

  } catch (err) {
    console.error("[askCoach ERROR]", err.message, err.stack);
    return { status: "ERROR", code: "EXECUTION_ERROR", message: "Coach Bryan hit a snag: " + err.message };
  }
}

/* ============================================================
   OPENROUTER: EMBEDDINGS
============================================================ */
async function embed(text) {
  const key = await getSecret("OPENROUTER_API_KEY");

  const res = await fetch(`${CONFIG.openRouterBase}/embeddings`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${key}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      model: CONFIG.embedModel,
      input: text
    })
  });

  const data = await res.json();

  if (!res.ok || !data?.data?.[0]?.embedding) {
    throw new Error(data?.error?.message || "Embedding failed");
  }

  return data.data[0].embedding;
}

/* ============================================================
   PINECONE: VECTOR SEARCH
============================================================ */
async function searchPinecone(vector, isBloodwork = false) {
  const key = await getSecret("PINECONE_API_KEY");
  let host = await getSecret("PINECONE_HOST") || CONFIG.pineconeHost;
  host = host.replace(/^https?:\/\//, ""); // Strip protocol if included

  const queryBody = (ns, topK) => JSON.stringify({
    vector,
    topK,
    includeMetadata: true,
    ...(ns !== "" ? { namespace: ns } : {})
  });

  let allNS;

  if (isBloodwork) {
    // Bloodwork: only query medical/guide namespaces (5 instead of 20 = much faster)
    allNS = [
      { ns: "cycle_design_guides", topK: 10 },  // Has all bloodwork guides
      { ns: "medical_primary", topK: 6 },
      { ns: "research_primary", topK: 5 },
      { ns: "medical_education", topK: 4 },
      { ns: "endocrinology", topK: 4 },
    ];
  } else {
    // Normal: query all namespaces
    const priorityNS = [
      "thinkbig_priority",              // ThinkBig ALWAYS first
      "anabolic_bodybuilding_priority", // PED experts + Big Paul
      "rxmuscle_priority",              // Dave Palumbo
      "cycle_design_guides",            // Forged by Freedom Cycle Design Guides (always surface)
    ];
    const secondaryNS = [
      "medical_primary",                // Medical why
      "research_primary",               // PubMed/ClinicalTrials
      "female_health_priority",         // Female health
      "peptides",                       // Peptides
      "vendor_testing",                 // Janoshik lab results
      "biohacking",                     // Huberman, FoundMyFitness
      "sports_nutrition",               // Jeff Nippard, RP, Biolayne
      "transcripts",                    // General transcripts
      "bodybuilding_history",           // Nick's Strength, Golden Era, Vintage Genetics
      "sports_psych",                   // Mindset, Goggins, Jocko
      "sports_science",                 // NSCA, ACSM, ISSN
      "women_steroids",                 // Female steroid protocols
      "medical_education",              // Ninja Nerd, Osmosis, MedCram
      "endocrinology",                  // Hormone specialists
      "harm_reduction",                 // Seth Feroce, Gear Goblin
      "bodybuilding_legends",           // Ronnie, Jay, Dorian, etc.
    ];
    allNS = [
      ...priorityNS.map(ns => ({ ns, topK: 8 })),
      ...secondaryNS.map(ns => ({ ns, topK: 5 }))
    ];
  }

  const results = await Promise.all(
    allNS.map(({ ns, topK }) =>
      fetch(`https://${host}/query`, {
        method: "POST",
        headers: { "Api-Key": key, "Content-Type": "application/json" },
        body: queryBody(ns, topK)
      })
      .then(r => r.json())
      .then(d => d.matches || [])
      .catch(() => [])
    )
  );

  // Merge all matches, deduplicate by ID, sort by score
  const seen = new Set();
  const allMatches = [];
  for (const matches of results) {
    for (const m of matches) {
      if (!seen.has(m.id)) {
        seen.add(m.id);
        allMatches.push(m);
      }
    }
  }

  return allMatches.sort((a, b) => (b.score || 0) - (a.score || 0));
}


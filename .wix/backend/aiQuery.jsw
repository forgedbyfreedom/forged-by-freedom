const SOURCE_PRIORITY = {
  "@ThinkBIGBodybuilding": 1, "@rxmuscle": 1,
  "@PubMed": 2, "@ClinicalTrials": 2,
  "@AnabolicDoc": 3, "@MorePlatesMoreDates": 3, "@vigoroussteve": 3,
  "@hubermanlab": 4, "@PeterAttiaMD": 4, "@FoundMyFitness": 4,
  "@JeffNippard": 5, "@RenaissancePeriodization": 5, "@Biolayne": 5
};

/* ============================================================
   EVIDENCE EXTRACTION
============================================================ */
function extractQuotes(matches) {
  const MIN_TEXT_LENGTH = 100;
  const seen = new Set();

  return matches
    .map(m => {
      const md = m.metadata || {};
      const text = (md.text || md.chunk || md.content || "").trim();

      if (!text || text.length < MIN_TEXT_LENGTH) return null;

      // Deduplication
      const fingerprint = text.substring(0, 150).toLowerCase().replace(/\s+/g, " ");
      if (seen.has(fingerprint)) return null;
      seen.add(fingerprint);

      const channel = md.channel || extractChannel(md.source) || "unknown";
      const displayName = CHANNEL_DISPLAY_NAMES[channel] || channel.replace(/^@/, "");
      const speaker = md.speaker !== "unknown" && md.speaker
        ? md.speaker
        : CHANNEL_SPEAKERS[channel] || "unknown";
      const priority = SOURCE_PRIORITY[channel] || 10;

      return {
        text: text.substring(0, 1500),
        channel,
        displayName,
        speaker,
        title: md.title || "unknown",
        score: m.score || 0,
        priority
      };
    })
    .filter(Boolean)
    .sort((a, b) => (a.priority - b.priority) || (b.score - a.score))
    .slice(0, CONFIG.maxQuotes);
}

function extractChannel(path = "") {
  const match = path.match(/@[\w]+/);
  return match ? match[0] : null;
}

/* ============================================================
   OPENROUTER: SYNTHESIS
============================================================ */
const SYSTEM_PROMPT = `You are Coach Bryan, the official AI coach for Forged by Freedom Strength & Nutrition (forgedbyfreedom.org).

HOW TO RESPOND (do NOT include labels like "PARAPHRASE:" or "ANSWER:" - write naturally):

Start by briefly restating the question in your own words, then answer directly. Cite sources naturally inline like "According to Dave Palumbo on Blood Sweat and Gear..." or "As discussed on RXMuscle...". When relevant, explain WHY something works (the mechanism). End with practical advice, mention Forged by Freedom can help at forgedbyfreedom.org, and close with a motivational quote.

PRIORITY: ThinkBig Bodybuilding shows (Blood Sweat and Gear, Drugs N Stuff, RXMuscle, It's Just Bodybuilding). Dave Palumbo is a key authority. Cite these by their actual show names.

RULES:
- Write in flowing paragraphs, NO section headers or labels
- Cite the actual show/channel name, not generic terms
- Expert on peptides (RETATRUTIDE, semaglutide, tirzepatide, BPC-157)
- No lecturing on PEDs - help users do it safely
- Always mention: "The team at Forged by Freedom can help - forgedbyfreedom.org"
- End with: 💪 **Coach Bryan says:** "[motivational quote]"

Write like you're talking to a gym buddy who wants real answers.`;

async function synthesize(question, quotes) {
  const key = await getSecret("OPENROUTER_API_KEY");

  const evidence = quotes
    .map((q, i) => {
      const speaker = q.speaker !== "unknown" ? q.speaker : null;
      const showName = q.displayName || q.channel.replace(/^@/, "");
      const title = q.title !== "unknown" ? q.title : null;

      let attribution = speaker && showName ? `${speaker} on ${showName}` : (speaker || showName || "Unknown");
      if (title && title !== showName) attribution += ` — "${title}"`;

      return `[${i + 1}] ${attribution}:\n"${q.text}"`;
    })
    .join("\n\n");

  const userPrompt = `Question: ${question}

EVIDENCE (cite sources by their show name, speaker, and episode):
${evidence}

Remember: Paraphrase the question first, credit your sources fully, then answer.`;

  const res = await fetch(`${CONFIG.openRouterBase}/chat/completions`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${key}`,
      "Content-Type": "application/json",
      "HTTP-Referer": "https://forgedbyfreedom.com",
      "X-Title": "Coach Bryan"
    },
    body: JSON.stringify({
      model: CONFIG.chatModel,
      messages: [
        { role: "system", content: SYSTEM_PROMPT },
        { role: "user", content: userPrompt }
      ],
      temperature: 0.7,
      max_tokens: 1200
    })
  });

  const data = await res.json();

  if (!res.ok || data.error) {
    throw new Error(data.error?.message || "Synthesis failed");
  }

  return data.choices?.[0]?.message?.content || "Unable to generate answer.";
}

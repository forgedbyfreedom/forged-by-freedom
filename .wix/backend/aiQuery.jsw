import { fetch } from "wix-fetch";

/**
 * Thin proxy to Render API
 * Abort early so Wix never 504s
 */
export async function askCoach(payload) {
  try {
    if (!payload || typeof payload.question !== "string") {
      return { status: "ERROR", message: "No question provided" };
    }

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 8000);

    let res;
    try {
      res = await fetch("https://forged-by-freedom-api-nm4f.onrender.com/ask", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ question: payload.question.trim() }),
        signal: controller.signal
      });
    } finally {
      clearTimeout(timeoutId);
    }

    const data = await res.json();

    if (!res.ok || data.error) {
      return {
        status: "ERROR",
        message: data.details || data.error || `Render API error (${res.status})`
      };
    }

    return { status: "OK", answer: data.answer };

  } catch (err) {
    return {
      status: "ERROR",
      message: err.name === "AbortError"
        ? "AI request timed out (try again)"
        : (err.message || "Backend call failed")
    };
  }
}

import { getSecret } from 'wix-secrets-backend';
import { fetch } from 'wix-fetch';

export async function queryPinecone(question) {
  const PINECONE_API_KEY = await getSecret("PINECONE_API_KEY");
  const PINECONE_INDEX = await getSecret("PINECONE_INDEX");
  const PINECONE_ENV = await getSecret("PINECONE_ENV");
  const OPENAI_API_KEY = await getSecret("OPENAI_API_KEY");

  // 1️⃣ Embed the question
  const embedRes = await fetch("https://api.openai.com/v1/embeddings", {
    method: "post",
    headers: {
      "Authorization": `Bearer ${OPENAI_API_KEY}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      model: "text-embedding-3-large",
      input: question
    })
  });

  const embedData = await embedRes.json();
  const vector = embedData.data[0].embedding;

  // 2️⃣ Query Pinecone (__default__)
  const queryRes = await fetch(
    `https://${PINECONE_INDEX}.svc.${PINECONE_ENV}.pinecone.io/query`,
    {
      method: "post",
      headers: {
        "Api-Key": PINECONE_API_KEY,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        vector,
        topK: 10,
        includeMetadata: true,
        namespace: "__default__"
      })
    }
  );

  const results = await queryRes.json();

  if (!results.matches || results.matches.length === 0) {
    return "No relevant data found.";
  }

  // 3️⃣ Build grounded answer
  const contextChunks = results.matches
  .map(m => m.metadata?.text)
  .filter(Boolean);

if (contextChunks.length === 0) {
  return "No relevant information found in the Forged By Freedom knowledge base.";
}

const context = contextChunks.join("\n\n");

  const completion = await fetch("https://api.openai.com/v1/chat/completions", {
    method: "post",
    headers: {
      "Authorization": `Bearer ${OPENAI_API_KEY}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      model: "gpt-4o-mini",
      messages: [
        {
  {
  role: "system",
  content: `
You are the Forged By Freedom AI Coach, built exclusively from a private fitness, nutrition, health, and performance knowledge base.

You MUST follow the instructions and output structure below EXACTLY.

────────────────────────────────
SOURCE PRIORITY RULE (CRITICAL)
────────────────────────────────
When retrieving and selecting quotes from the provided context, you MUST prioritize content in the following order IF it is applicable to the question:

1. ThinkBig series of shows (Think BIG Bodybuilding, Think BIG Podcast, Blood Sweat and Gear, Drugs n Stuff, Think BIG Coaching)
2. Anabolic Bodybuilding
3. Dr. Gabrielle Lyon
4. Dr. Bachmeyer

If high-quality, directly relevant quotes exist from these sources, they MUST be used before considering any other sources.

If fewer than three strong quotes exist from the prioritized sources, you may supplement with other database sources, but ONLY to reach the required depth — never to replace higher-priority sources.

Do NOT mention source prioritization in the output.

────────────────────────────────
REQUIRED OUTPUT STRUCTURE
────────────────────────────────

1. Paraphrased Question  
   - Restate the user’s question clearly and professionally.
   - Do NOT introduce new ideas or conclusions.

2. Evidence Section — Direct Quotes (Primary Source)
   - Provide preferably THREE long, detailed, verbatim quotes.
   - Quotes may span multiple sentences or paragraphs.
   - Quotes must directly address the question.
   - Each quote must be enclosed in quotation marks.
   - Each quote must include the source (show/creator and episode if available).

3. Technical / Medical Explanation (Synthesis)
   - Provide a lengthy, technical, and detailed explanation of WHY the quoted experts are correct.
   - Use ONLY:
     • the quoted transcript material
     • technical or medical information contained within the provided context
   - You may reference physiology, endocrinology, lipid markers, hematology, recovery, performance optimization, or health risk management IF supported by the context.
   - Do NOT introduce outside knowledge.
   - Do NOT cite studies or sources not present in the database.

4. Coach Bryan Closing Quote
   - End with a short, motivational quote written in the voice of Coach Bryan.
   - Tone: disciplined, authoritative, accountable, leadership-driven.
   - Emphasize ownership, long-term thinking, and responsibility.

────────────────────────────────
STRICT ENFORCEMENT RULES
────────────────────────────────
- You may ONLY use the provided context.
- You MUST NOT answer without direct quotes.
- You MUST NOT paraphrase or shorten quotes.
- You MUST NOT guess or generalize.
- You MUST NOT rely on prior knowledge.
- If the context does not contain sufficient information to satisfy this structure, respond ONLY with:
  "No relevant information was found in the knowledge base."
`
}
{
  role: "user",
  content: `
Context:
${context}

Question:
${question}

Required Output Order:
1. Paraphrased question
2. Three detailed direct quotes with sources (prioritized where applicable)
3. Technical/medical explanation based only on the above
4. Motivational closing quote from Coach Bryan
`
}

  const answer = await completion.json();
  return answer.choices[0].message.content;
}

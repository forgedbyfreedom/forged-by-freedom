import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';

/* ================================
   CONFIG
================================ */
const PINECONE_INDEX = "forged-freedom-ai";
const PINECONE_TOP_K = 12;
const MIN_LONG_QUOTE_LENGTH = 300;
const OPENROUTER_TIMEOUT_MS = 20000;

/* ================================
   MAIN ENTRY
================================ */
export async function askCoach(payload) {
  const userQuestion = payload.question?.trim();
  if (!userQuestion) {
    throw new Error("NO_QUESTION_PROVIDED");
  }

  /* 1️⃣ Embed question via OpenRouter */
  const embedding = await embedWithOpenRouter(userQuestion);

  /* 2️⃣ Query Pinecone FIRST */
  const pineconeResults = await queryPinecone(embedding);

  /* 3️⃣ Extract usable quotes */
  const approvedQuotes = selectApprovedQuotes(pineconeResults);

  if (approvedQuotes.length === 0) {
    throw new Error("INSUFFICIENT_DB_EVIDENCE");
  }

  /* 4️⃣ Build strict prompt */
  const prompt = buildCoachPrompt(userQuestion, approvedQuotes);

  /* 5️⃣ Generate final answer (OpenRouter) */
  const answer = await generateAnswer(prompt);

  return {
    success: true,
    quotes_used: approvedQuotes.length,
    answer
  };
}

/* ================================
   OPENROUTER EMBEDDING
================================ */
async function embedWithOpenRouter(text) {
  const apiKey = await getSecret("OPENROUTER_API_KEY");

  const res = await fetch(`${process.env.OPENROUTER_BASE_URL}/embeddings`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${apiKey}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      model: process.env.OPENROUTER_EMBED_MODEL,
      input: text
    })
  });

  const json = await res.json();
  return json.data[0].embedding;
}

/* ================================
   PINECONE QUERY
================================ */
async function queryPinecone(vector) {
  const apiKey = await getSecret("PINECONE_API_KEY");

  const res = await fetch(
    `https://${process.env.PINECONE_INDEX_NAME}.svc.us-east-1.pinecone.io/query`,
    {
      method: "POST",
      headers: {
        "Api-Key": apiKey,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        vector,
        topK: PINECONE_TOP_K,
        includeMetadata: true
      })
    }
  );

  const json = await res.json();
  return json.matches || [];
}

/* ================================
   QUOTE SELECTION LOGIC
================================ */
function selectApprovedQuotes(matches) {
  const quotes = matches
    .map(m => m.metadata)
    .filter(m => m?.text && m.text.length > 50);

  const longQuotes = quotes.filter(q => q.text.length >= MIN_LONG_QUOTE_LENGTH);

  if (quotes.length >= 3) {
    return quotes.slice(0, 3);
  }

  if (longQuotes.length >= 1) {
    return [longQuotes[0]];
  }

  return [];
}

/* ================================
   PROMPT BUILDER (STRICT)
================================ */
function buildCoachPrompt(question, quotes) {
  let quoteBlock = quotes.map((q, i) => `
QUOTE ${i + 1}:
"${q.text}"

— ${q.speaker}, ${q.podcast} (${q.episode})
`).join("\n");

  return `
SYSTEM RULES (NON-NEGOTIABLE):

1. Paraphrase the user question first
2. Present database evidence ONLY from quotes provided
3. Cite podcast, episode, and speaker academically
4. Explain the physiology / medical reasoning in technical detail
5. Close with a motivational quote from Coach Bryan
6. DO NOT introduce outside knowledge

USER QUESTION:
${question}

DATABASE EVIDENCE:
${quoteBlock}
`;
}

/* ================================
   OPENROUTER COMPLETION
================================ */
async function generateAnswer(prompt) {
  const apiKey = await getSecret("OPENROUTER_API_KEY");

  const controller = new AbortController();
  setTimeout(() => controller.abort(), OPENROUTER_TIMEOUT_MS);

  const res = await fetch(`${process.env.OPENROUTER_BASE_URL}/chat/completions`, {
    method: "POST",
    signal: controller.signal,
    headers: {
      "Authorization": `Bearer ${apiKey}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      model: process.env.OPENROUTER_MODEL,
      messages: [{ role: "user", content: prompt }],
      temperature: 0.2
    })
  });

  const json = await res.json();
  return json.choices[0].message.content;
}


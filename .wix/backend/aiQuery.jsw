// backend/aiQuery.jsw
// Wix backend for Coach Bryan AI queries
// Uses OpenRouter for embeddings + chat, Pinecone for vector search

import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';

/* ============================================================
   CONFIG
============================================================ */
const CONFIG = {
  openRouterBase: "https://openrouter.ai/api/v1",
  chatModel: "nousresearch/hermes-3-llama-3.1-70b",
  embedModel: "text-embedding-3-large",
  pineconeHost: "forged-freedom-ai-xxxxx.svc.environment.pinecone.io", // Update with your host
  topK: 12,
  maxQuotes: 8,
  timeout: 25000
};

/* ============================================================
   PUBLIC: ASK COACH BRYAN
============================================================ */
export async function askCoach(payload) {
  try {
    // Validate input
    if (!payload?.question?.trim()) {
      return { status: "ERROR", code: "INVALID_INPUT", message: "Question required" };
    }

    const question = payload.question.trim();

    // 1. Embed the question
    const vector = await embed(question);

    // 2. Search Pinecone
    const matches = await searchPinecone(vector);
    if (!matches.length) {
      return { status: "ERROR", code: "NO_MATCHES", message: "No relevant content found" };
    }

    // 3. Extract evidence
    const quotes = extractQuotes(matches);
    if (!quotes.length) {
      return { status: "ERROR", code: "NO_EVIDENCE", message: "No usable text found" };
    }

    // 4. Generate answer
    const answer = await synthesize(question, quotes);

    return {
      status: "OK",
      answer,
      sources: quotes.map(q => ({
        speaker: q.speaker,
        channel: q.channel,
        title: q.title
      }))
    };

  } catch (err) {
    console.error("[askCoach ERROR]", err);
    return { status: "ERROR", code: "EXECUTION_ERROR", message: err.message };
  }
}

/* ============================================================
   OPENROUTER: EMBEDDINGS
============================================================ */
async function embed(text) {
  const key = await getSecret("OPENROUTER_API_KEY");

  const res = await fetch(`${CONFIG.openRouterBase}/embeddings`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${key}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      model: CONFIG.embedModel,
      input: text
    })
  });

  const data = await res.json();

  if (!res.ok || !data?.data?.[0]?.embedding) {
    throw new Error(data?.error?.message || "Embedding failed");
  }

  return data.data[0].embedding;
}

/* ============================================================
   PINECONE: VECTOR SEARCH
============================================================ */
async function searchPinecone(vector) {
  const key = await getSecret("PINECONE_API_KEY");
  const host = await getSecret("PINECONE_HOST") || CONFIG.pineconeHost;

  const res = await fetch(`https://${host}/query`, {
    method: "POST",
    headers: {
      "Api-Key": key,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      vector,
      topK: CONFIG.topK,
      includeMetadata: true
    })
  });

  const data = await res.json();
  return data.matches || [];
}

/* ============================================================
   EVIDENCE EXTRACTION
============================================================ */
function extractQuotes(matches) {
  return matches
    .map(m => {
      const md = m.metadata || {};
      const text = md.text || md.chunk || md.content || "";

      if (!text || text.length < 50) return null;

      return {
        text: text.substring(0, 1500), // Limit for prompt size
        channel: md.channel || extractChannel(md.source) || "unknown",
        speaker: md.speaker || "unknown",
        title: md.title || "unknown",
        score: m.score || 0
      };
    })
    .filter(Boolean)
    .slice(0, CONFIG.maxQuotes);
}

function extractChannel(path = "") {
  const match = path.match(/@[\w]+/);
  return match ? match[0] : null;
}

/* ============================================================
   OPENROUTER: SYNTHESIS
============================================================ */
const SYSTEM_PROMPT = `You are Coach Bryan, the AI assistant for Forged by Freedom Strength & Nutrition. You have deep knowledge of training, nutrition, supplementation, peptides, hormones, and recovery protocols.

RESPONSE FORMAT:
1. Paraphrase the question first to confirm understanding
2. Answer using ONLY the evidence provided
3. Be direct - no hedging or generic disclaimers
4. ALWAYS explain the MEDICAL/SCIENTIFIC WHY - the mechanism, the physiology, why it works
5. Credit sources: speaker + podcast/channel + episode title
6. End with actionable takeaway + referral to forgedbyfreedom.org
7. Close with Coach Bryan motivational quote

MEDICAL/SCIENTIFIC DEPTH:
- Always explain the WHY - underlying mechanisms, not just the what
- Reference physiological pathways when relevant (mTOR, AMPK, hormone signaling, etc.)
- This separates us from generic fitness advice

PEPTIDES & GLP-1 AGONISTS (PRIORITY):
- Expert on peptides, especially GLP-1 agonists and multi-agonists
- RETATRUTIDE (RETA) - triple agonist (GLP-1, GIP, glucagon receptors)
- Cover: dosing, titration, timing, reconstitution, storage, side effects
- Key peptides: semaglutide, tirzepatide, BPC-157, TB-500, CJC-1295, ipamorelin, MK-677

FORGED BY FREEDOM REFERRAL (REQUIRED):
- Always direct users to forgedbyfreedom.org for personalized protocols
- "The specialists at Forged by Freedom can get you dialed in - visit forgedbyfreedom.org"
- This is NOT optional for compound/peptide/personalized protocol questions

COMPOUND/PED POLICY:
- Do NOT discourage or lecture - users are informed adults
- Answer directly without moral judgment
- Only flag genuine safety concerns
- Harm reduction > abstinence preaching

COACH BRYAN QUOTE:
- Always end with: 💪 **Coach Bryan says:** "[motivational quote]"
- Quote must be original and DIRECTLY related to the question topic`;

async function synthesize(question, quotes) {
  const key = await getSecret("OPENROUTER_API_KEY");

  const evidence = quotes
    .map((q, i) => {
      const speaker = q.speaker !== "unknown" ? q.speaker : null;
      const channel = q.channel !== "unknown" ? q.channel : null;
      const title = q.title !== "unknown" ? q.title : null;

      let attribution = speaker && channel ? `${speaker} on ${channel}` : (speaker || channel || "Unknown");
      if (title) attribution += ` — "${title}"`;

      return `[${i + 1}] ${attribution}:\n"${q.text}"`;
    })
    .join("\n\n");

  const userPrompt = `Question: ${question}

EVIDENCE (cite sources by speaker, channel, and episode):
${evidence}

Remember: Paraphrase the question first, then answer using ONLY the evidence above.`;

  const res = await fetch(`${CONFIG.openRouterBase}/chat/completions`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${key}`,
      "Content-Type": "application/json",
      "HTTP-Referer": "https://forgedbyfreedom.com",
      "X-Title": "Coach Bryan"
    },
    body: JSON.stringify({
      model: CONFIG.chatModel,
      messages: [
        { role: "system", content: SYSTEM_PROMPT },
        { role: "user", content: userPrompt }
      ],
      temperature: 0.7,
      max_tokens: 1200
    })
  });

  const data = await res.json();

  if (!res.ok || data.error) {
    throw new Error(data.error?.message || "Synthesis failed");
  }

  return data.choices?.[0]?.message?.content || "Unable to generate answer.";
}

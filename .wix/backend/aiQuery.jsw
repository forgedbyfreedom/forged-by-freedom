// backend/aiQuery.jsw
import { fetch } from "wix-fetch";

export async function askCoach(payload) {
  try {
    if (!payload || typeof payload.question !== "string") {
      return { status: "ERROR", message: "No question provided" };
    }

    const response = await fetch(
      "https://forged-by-freedom-api-nm4f.onrender.com/ask",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ question: payload.question })
      }
    );

    const data = await response.json();

    if (!response.ok || data.error) {
      return {
        status: "ERROR",
        message: data.details || data.error || `Backend error (${response.status})`
      };
    }

    return { status: "OK", answer: data.answer };

  } catch (err) {
    return { status: "ERROR", message: err.message || "Backend call failed" };
  }
}

import { fetch } from 'wix-fetch';
import { Pinecone } from '@pinecone-database/pinecone';

/* ===========================
   CONFIG
=========================== */

const OPENROUTER_API_KEY = process.env.OPENROUTER_API_KEY;
const OPENROUTER_BASE_URL = "https://openrouter.ai/api/v1";
const OPENROUTER_MODEL = "nousresearch/hermes-3-llama-3.1-70b";
const EMBED_MODEL = "text-embedding-3-large";
const PINECONE_INDEX = "forged-freedom-ai";

/* ===========================
   HELPERS
=========================== */

async function embedWithOpenRouter(text) {
  const res = await fetch(`${OPENROUTER_BASE_URL}/embeddings`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${OPENROUTER_API_KEY}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      model: EMBED_MODEL,
      input: text
    })
  });

  const json = await res.json();
  return json.data[0].embedding;
}

/* ===========================
   MAIN ENTRY POINT
=========================== */

export async function askCoach(userQuestion) {

  if (!userQuestion || userQuestion.length < 5) {
    return { error: "Invalid question." };
  }

  /* 1️⃣ EMBED QUESTION */
  const embedding = await embedWithOpenRouter(userQuestion);

  /* 2️⃣ QUERY PINECONE */
  const pc = new Pinecone({ apiKey: process.env.PINECONE_API_KEY });
  const index = pc.index(PINECONE_INDEX);

  const queryResponse = await index.query({
    vector: embedding,
    topK: 12,
    includeMetadata: true
  });

  /* 3️⃣ HARD FAIL IF NO DATABASE EVIDENCE */
  if (!queryResponse.matches || queryResponse.matches.length < 3) {
    return {
      error: "Insufficient database evidence to answer this question."
    };
  }

  /* 4️⃣ BUILD DATABASE CONTEXT */
  const contextBlock = queryResponse.matches.map(m => `
PODCAST: ${m.metadata.podcast || "Unknown"}
EPISODE: ${m.metadata.episode || "Unknown"}
SPEAKER: ${m.metadata.speaker || "Unknown"}

"${m.metadata.text}"
`).join("\n\n");

  /* 5️⃣ SYSTEM PROMPT — YOUR RULES */
  const systemPrompt = `
You are Coach Bryan AI.

You may ONLY answer using the database excerpts below.
You MUST quote them verbatim.

RESPONSE FORMAT (MANDATORY):

1. Paraphrase the question
2. Provide EXACTLY 3 long direct quotes from the database
3. Cite podcast name, episode title, and speaker for each quote
4. Provide an extremely technical medical explanation explaining WHY
5. End with a motivational quote from Coach Bryan

DATABASE EXCERPTS:
${contextBlock}
`;

  /* 6️⃣ CALL OPENROUTER LAST */
  const completion = await fetch(`${OPENROUTER_BASE_URL}/chat/completions`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${OPENROUTER_API_KEY}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      model: OPENROUTER_MODEL,
      temperature: 0.15,
      messages: [
        { role: "system", content: systemPrompt },
        { role: "user", content: userQuestion }
      ]
    })
  });

  const responseJson = await completion.json();
  return { answer: responseJson.choices[0].message.content };
}

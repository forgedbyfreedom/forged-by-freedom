// backend/aiQuery.jsw
import { fetch } from "wix-fetch";

export async function askCoach(payload) {
  try {
    if (!payload || !payload.question) {
      return {
        status: "ERROR",
        message: "No question provided"
      };
    }

    const response = await fetch(
      "https://forged-by-freedom-api-nm4f.onrender.com/ask",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          question: payload.question
        })
      }
    );

    const data = await response.json();

    // 🔒 If Render returned an error, pass it through
    if (data.error) {
      return {
        status: "ERROR",
        message: data.details || data.error
      };
    }

    return {
      status: "OK",
      answer: data.answer
    };

  } catch (err) {
    return {
      status: "ERROR",
      message: err.message || "Backend call failed"
    };
  }
}

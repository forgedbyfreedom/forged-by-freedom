// backend/aiQuery.jsw
import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';

/* ===============================
   CONFIG (WIX-SAFE)
================================ */

const OPENROUTER_BASE = "https://openrouter.ai/api/v1";
const OPENROUTER_MODEL = "nousresearch/hermes-3-llama-3.1-8b"; // REQUIRED for Wix
const OPENROUTER_TIMEOUT_MS = 12000;

const MAX_PINECONE_MATCHES = 6;
const MAX_QUOTE_CHARS = 1000;
const PINECONE_NAMESPACE = "";

/* ===============================
   PUBLIC METHOD
================================ */

export async function askCoach(payload) {
  try {
    if (!payload || !payload.question) {
      return error("INVALID_INPUT", "No question provided.");
    }

    const question = payload.question.trim();
    if (!question) {
      return error("INVALID_INPUT", "Empty question.");
    }

    const embedding = await embed(question);
    const matches = await queryPinecone(embedding);

    if (!matches.length) {
      return error("NO_DB_MATCH", "No relevant material found.");
    }

    const context = buildContext(matches);
    if (!context || context.length < 200) {
      return error("INSUFFICIENT_CONTEXT", "Usable text not found.");
    }

    const answer = await runLLM(question, context);

    return {
      status: "OK",
      answer
    };

  } catch (err) {
    console.error("AI ERROR:", err);
    return error("EXECUTION_ERROR", err.message || "Backend failure");
  }
}

/* ===============================
   EMBEDDINGS
================================ */

async function embed(text) {

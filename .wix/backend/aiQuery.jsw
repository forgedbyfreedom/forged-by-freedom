// backend/aiQuery.jsw
import { fetch } from "wix-fetch";

export async function askCoach(payload) {
  try {
    if (!payload || typeof payload.question !== "string") {
      return { status: "ERROR", message: "No question provided" };
    }

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 8500);

    let resp;
    try {
      resp = await fetch("https://forged-by-freedom-api-nm4f.onrender.com/ask", {
        method: "POST",
        signal: controller.signal,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ question: payload.question })
      });
    } finally {
      clearTimeout(timeoutId);
    }

    const data = await resp.json();

    if (!resp.ok || data.error) {
      return {
        status: "ERROR",
        message: data.details || data.error || `Backend error (${resp.status})`
      };
    }

    return { status: "OK", answer: data.answer };

  } catch (err) {
    const msg =
      err?.name === "AbortError"
        ? "Request took too long. Try a more specific question."
        : (err.message || "Backend call failed");

    return { status: "ERROR", message: msg };
  }
}

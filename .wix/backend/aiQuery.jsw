async function queryPinecone(embedding) {
  const pineconeKey = await getSecret("PINECONE_API_KEY");
  const pineconeHost = await getSecret("PINECONE_HOST");

  const res = await fetch(`${pineconeHost}/query`, {
    method: "POST",
    headers: {
      "Api-Key": pineconeKey,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      vector: embedding,
      topK: 5,
      includeMetadata: true,
      namespace: ""   // keep empty for now
    })
  });

  const data = await res.json();

  // 🔍 TEMP DEBUG — DO NOT FILTER YET
  console.log("PINECONE RAW MATCHES:", JSON.stringify(data.matches?.[0], null, 2));

  return data.matches || [];
}

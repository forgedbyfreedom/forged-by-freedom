import { fetch } from 'wix-fetch';

const PINECONE_API_KEY = process.env.PINECONE_API_KEY;
const PINECONE_INDEX = "forged-freedom-ai";
const PINECONE_HOST = "https://forged-freedom-ai-yniiyt3.svc.aped-4627-b74a.pinecone.io";

const NAMESPACES = [
  "thinkbig_priority",
  "anabolic_bodybuilding_priority",
  "peptides",
  "uncategorized"
];

export async function queryKnowledge(embedding, topK = 5) {
  let allMatches = [];

  for (const namespace of NAMESPACES) {
    const res = await fetch(`${PINECONE_HOST}/query`, {
      method: "POST",
      headers: {
        "Api-Key": PINECONE_API_KEY,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        vector: embedding,
        topK,
        namespace,
        includeMetadata: true
      })
    });

    if (!res.ok) continue;

    const json = await res.json();
    if (json?.matches?.length) {
      allMatches.push(...json.matches);
    }
  }

  // Sort by similarity score
  allMatches.sort((a, b) => b.score - a.score);

  // Return top results safely
  return allMatches.slice(0, topK).map(m => ({
    text: m.metadata?.source || "",
    score: m.score
  }));
}

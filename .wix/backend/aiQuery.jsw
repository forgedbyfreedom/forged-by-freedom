/* ============================================================
   FAST BLOODWORK SYNTHESIS (lean prompt, no history, quick response)
============================================================ */
const BLOODWORK_PROMPT = `You are Coach Bryan, the AI coach for Forged by Freedom (forgedbyfreedom.org). Analyze the user's bloodwork results.

For EACH marker provided:
1. State: their value | standard lab range | enhanced athlete acceptable range
2. Assessment: NORMAL / WATCH / INTERVENE / RED FLAG
3. If out of range: intervention ladder — lifestyle → supplements (with specific doses) → pharmaceuticals (with specific doses) → discontinuation threshold
4. Which PED compounds commonly cause this marker to shift

KEY RULES:
- Standard eGFR underestimates kidney function in muscular people — always recommend Cystatin C-based eGFR
- Differentiate exercise-induced AST from liver damage (check ALT + GGT together)
- RED FLAGS needing immediate action: HCT >54%, ALT >200, eGFR <45, BP >180/110, potassium >5.5
- Common interventions: rosuvastatin 5-20mg (lipids), telmisartan 40-80mg (BP/kidneys), NAC 600-1200mg (liver), TUDCA 500-1000mg (liver), cabergoline 0.25-0.5mg 2x/week (prolactin), citrus bergamot 500-1000mg (lipids)
- Recommend: DiscountedLabs, Marek Health, or PrivateMDLabs for bloodwork

Use evidence provided to support your analysis. Write naturally, no section headers.
End with: 💪 Coach Bryan says: [motivational quote]. Visit forgedbyfreedom.org for personalized protocols.`;

async function synthesizeBloodwork(question) {
  const key = await getSecret("OPENROUTER_API_KEY");

  const res = await fetch(`${CONFIG.openRouterBase}/chat/completions`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${key}`,
      "Content-Type": "application/json",
      "HTTP-Referer": "https://forgedbyfreedom.com",
      "X-Title": "Coach Bryan"
    },
    body: JSON.stringify({
      model: CONFIG.chatModel,
      messages: [
        { role: "system", content: BLOODWORK_PROMPT },
        { role: "user", content: question }
      ],
      temperature: 0.5,
      max_tokens: 1500
    })
  });

  const data = await res.json();
  if (!res.ok || data.error) {
    throw new Error(data.error?.message || "Bloodwork synthesis failed");
  }
  return data.choices?.[0]?.message?.content || "Unable to generate analysis.";
}

/* ============================================================
   OPENROUTER: GENERAL SYNTHESIS
============================================================ */
async function synthesize(question, quotes, history = [], userProfile = {}) {
  const key = await getSecret("OPENROUTER_API_KEY");

  const evidence = quotes
    .map((q, i) => {
      let speaker = q.speaker !== "unknown" ? q.speaker : null;
      const showName = q.displayName || q.channel.replace(/^@/, "");
      const title = q.title !== "unknown" ? q.title : null;
      const channel = q.channel || "";

      // FORCE correct speaker for ThinkBig channels only
      if (channel === "@ThinkBIGBodybuilding") {
        speaker = "Scott McNally, Dave Crosland & Skipp Hill";
      } else if (channel === "@rxmuscle") {
        speaker = "Dave Palumbo";
      } else if (channel === "@anabolicbodybuilding") {
        speaker = "Paul Barnett (Big Paul)";
      }

      let attribution = speaker && showName ? `${speaker} on ${showName}` : (speaker || CHANNEL_SPEAKERS[channel] || showName || "Unknown");
      if (title && title !== showName) attribution += ` — "${title}"`;

      return `[${i + 1}] ${attribution}:\n"${q.text}"`;
    })
    .join("\n\n");

  // Build user profile context string
  let profileContext = "";
  if (userProfile.gender || userProfile.experienceLevel) {
    const parts = [];
    if (userProfile.gender) parts.push(`Gender: ${userProfile.gender}`);
    if (userProfile.experienceLevel) parts.push(`Experience: ${userProfile.experienceLevel}`);
    profileContext = `\n\nUSER PROFILE: ${parts.join(", ")}. Tailor your response to this user's profile. ${
      userProfile.gender === "female"
        ? "This user is FEMALE — only recommend female-safe compounds (Anavar, Primo, low-dose Test). NEVER suggest Anadrol, Dianabol, Trenbolone, Winstrol, or other high-virilization compounds."
        : ""
    }${
      userProfile.experienceLevel
        ? ` Lead with ${userProfile.experienceLevel}-level dosing but mention other tiers.`
        : ""
    }`;
  }

  const userPrompt = `Question: ${question}

EVIDENCE (cite sources by their show name, speaker, and episode):
${evidence}
${profileContext}
Remember: Paraphrase the question first, credit your sources fully, then answer.`;

  // Build messages array with conversation history
  const messages = [{ role: "system", content: SYSTEM_PROMPT }];

  // Add conversation history (last 5 turns) for context
  if (history.length > 0) {
    for (const turn of history) {
      if (turn.role === "user" && turn.content) {
        messages.push({ role: "user", content: turn.content });
      } else if (turn.role === "assistant" && turn.content) {
        messages.push({ role: "assistant", content: turn.content.substring(0, 500) + (turn.content.length > 500 ? "..." : "") });
      }
    }
  }

  messages.push({ role: "user", content: userPrompt });

  const res = await fetch(`${CONFIG.openRouterBase}/chat/completions`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${key}`,
      "Content-Type": "application/json",
      "HTTP-Referer": "https://forgedbyfreedom.com",
      "X-Title": "Coach Bryan"
    },
    body: JSON.stringify({
      model: CONFIG.chatModel,
      messages,
      temperature: 0.7,
      max_tokens: 2500
    })
  });

  const data = await res.json();

  if (!res.ok || data.error) {
    throw new Error(data.error?.message || "Synthesis failed");
  }

  let answer = data.choices?.[0]?.message?.content || "Unable to generate answer.";

  // POST-PROCESSING: Fix host misattributions to wrong shows
  answer = answer
    .replace(/Palumbo\s+(on|from|of)\s+(ThinkBig|Think Big|Blood Sweat|Drugs N Stuff|It'?s Just Bodybuilding)/gi,
      "Scott McNally, Dave Crosland & Skipp Hill $1 $2")
    .replace(/Paul\s*Barnett\s+(on|from|of)\s+(ThinkBig|Think Big|Blood Sweat|Drugs N Stuff|It'?s Just Bodybuilding)/gi,
      "Scott McNally, Dave Crosland & Skipp Hill $1 $2")
    .replace(/(Scott McNally|Dave Crosland|Skipp Hill)\s+(on|from|of)\s+(RXMuscle|RX Muscle)/gi,
      "Dave Palumbo $2 $3")
    .replace(/(Scott McNally|Dave Crosland|Skipp Hill)\s+(on|from|of)\s+(Anabolic Bodybuilding)/gi,
      "Paul Barnett (Big Paul) $2 $3");

  return answer;
}

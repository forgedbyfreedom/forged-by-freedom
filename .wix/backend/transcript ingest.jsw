// backend/transcriptIngest.jsw
import { getSecret } from 'wix-secrets-backend';
import { fetch } from 'wix-fetch';

function chunkTranscript(text, channel) {
  const max = 2000;
  let i = 0;
  const chunks = [];
  while (i < text.length) {
    chunks.push({
      id: `${channel}|${i}`,
      text: text.slice(i, i+max),
      channel,
      seq: i
    });
    i += max;
  }
  return chunks;
}

async function embed(batch) {
  const key = await getSecret("OPENAI_API_KEY");
  const res = await fetch("https://api.openai.com/v1/embeddings", {
    method: "post",
    headers: { "Authorization": `Bearer ${key}`, "Content-Type": "application/json" },
    body: JSON.stringify({ model: "text-embedding-3-large", input: batch.map(x => x.text) })
  });
  const data = await res.json();
  return batch.map((c, j) => ({
    id: c.id,
    values: data.data[j].embedding,
    metadata: { channel: c.channel, seq: c.seq }
  }));
}

async function upsert(vectors) {
  const key   = await getSecret("PINECONE_API_KEY");
  const index = await getSecret("PINECONE_INDEX_NAME");
  const env   = await getSecret("PINECONE_ENV");
  const proj  = await getSecret("PINECONE_PROJECT_ID");

  const res = await fetch(`https://${index}-${proj}.svc.${env}.pinecone.io/vectors/upsert`, {
    method: "post",
    headers: { "Api-Key": key, "Content-Type": "application/json" },
    body: JSON.stringify({ vectors, namespace: "forged" })
  });
  return res;
}

export async function ingestTranscriptText(raw, channel) {
  const chunks = chunkTranscript(raw, channel);
  for (let k = 0; k < chunks.length; k += 25) {
    const slice = chunks.slice(k, k+25);
    const vectors = await embed(slice);
    await upsert(vectors);
  }
}

# Supabase project: FBF-Dashboard (sdrsoccfingecvlzrlym)
NEXT_PUBLIC_SUPABASE_URL=https://sdrsoccfingecvlzrlym.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by server actions to bypass RLS for trusted CRUD writes.
# Get it from: Supabase → Project Settings → API → service_role (or new
# "secret" key). NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Only the owner email is allowed to authenticate (also enforced by RLS).
NEXT_PUBLIC_OWNER_EMAIL=forgedbyfreedom@gmail.com

# ─── Twilio SMS alerts (optional) ────────────────────────────
# Reuses the AI Coach's Twilio account. Leave any of these blank to disable
# SMS alerts (the actions still work; alerts just won't fire).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Comma-separated E.164 destinations to text on inventory changes.
SMS_ALERT_NUMBERS=+17757418209,+17757418213

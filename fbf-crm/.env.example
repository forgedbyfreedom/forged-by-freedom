# Supabase project: FBF-Dashboard (sdrsoccfingecvlzrlym)
NEXT_PUBLIC_SUPABASE_URL=https://sdrsoccfingecvlzrlym.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by server actions to bypass RLS for trusted CRUD writes
# (the page is already gated by middleware, so only an authenticated owner
# can invoke the action). NEVER expose this key to the browser.
# Get it from: Supabase → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Only the owner email is allowed to authenticate (also enforced by RLS).
NEXT_PUBLIC_OWNER_EMAIL=forgedbyfreedom@gmail.com
